# Public — safe to expose to the browser
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only — NEVER expose to the browser or commit this value.
# Used only in server actions / route handlers that need to bypass RLS
# (e.g. admin writes that are also protected by an authenticated admin session).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
